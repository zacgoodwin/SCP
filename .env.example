# Copy to .env next to docker-compose.yml and edit. Every value shown is the default.

# Host ports compose publishes.
SCP_HOST_PORT=8080
SCP_HOST_ARTIFACT_PORT=8081

# Public URLs as browsers and agents reach them; different origins. Unset, they follow the host
# ports above (http://localhost:<port>). Behind HTTPS, set both to the real URLs.
# SCP_PUBLIC_URL=http://localhost:8080
# SCP_ARTIFACT_URL=http://localhost:8081

# First admin, created when the database is empty. Empty password = random, printed once in the logs.
SCP_ADMIN_EMAIL=admin@localhost
SCP_ADMIN_USERNAME=admin
SCP_ADMIN_PASSWORD=

# true or false (also 1/0, yes/no). Any other value stops the server at boot.
SCP_ALLOW_REGISTRATION=true
# SCP_TRUST_PROXY=true takes the client IP (audit, login rate limit) from the rightmost
# X-Forwarded-For entry, the one your reverse proxy appends. Only behind exactly one such proxy.
SCP_TRUST_PROXY=false

# Space-separated script/style origins artifacts may load from. Empty = cdnjs, jsdelivr, unpkg,
# tailwind and jquery.
SCP_ARTIFACT_CDNS=

# GitHub imports. A token raises the API rate limit and reads private repos; empty = the token saved
# under Admin > Settings, else anonymous. The API origin only changes for GitHub Enterprise Server.
SCP_GITHUB_TOKEN=
SCP_GITHUB_API=

# OIDC login. Issuer, client id and secret together enable it; each value set here overrides the
# matching Admin > Settings field and makes it read-only there. Register
# {SCP_PUBLIC_URL}/api/v1/auth/oidc/callback as the redirect URI at the identity provider.
SCP_OIDC_ISSUER=
SCP_OIDC_CLIENT_ID=
SCP_OIDC_CLIENT_SECRET=
# Create an account on a user's first sign-in (true), or only let existing accounts in (false).
SCP_OIDC_AUTO_REGISTER=
# Text of the login button. Empty = "Single sign-on".
SCP_OIDC_LABEL=

# How much one import may bring in. Empty = the Admin > Settings > Imports value, else 200 items,
# a 35 MB archive or upload, and 64 MB unpacked. Set here, each overrides that field and makes it
# read-only there. Whole numbers only: 1 to 2000 items, 1 to 256 MB; anything else stops the server at boot.
SCP_IMPORT_MAX_ITEMS=
SCP_IMPORT_MAX_ARCHIVE_MB=
SCP_IMPORT_MAX_PACK_MB=
