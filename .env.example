# Copy to .env next to docker-compose.yml and edit. Every value shown is the default.

# Host ports compose publishes.
SCP_HOST_PORT=8080
SCP_HOST_ARTIFACT_PORT=8081

# Public URLs as browsers and agents reach them; different origins. Unset, they follow the host
# ports above (http://localhost:<port>). Behind HTTPS, set both to the real URLs.
# SCP_PUBLIC_URL=http://localhost:8080
# SCP_ARTIFACT_URL=http://localhost:8081

# First admin, created when the database is empty. Empty password = random, printed once in the logs.
SCP_ADMIN_EMAIL=admin@localhost
SCP_ADMIN_USERNAME=admin
SCP_ADMIN_PASSWORD=

# true or false (also 1/0, yes/no). Any other value stops the server at boot.
SCP_ALLOW_REGISTRATION=true
# SCP_TRUST_PROXY=true takes the client IP (audit, login rate limit) from the rightmost
# X-Forwarded-For entry, the one your reverse proxy appends. Only behind exactly one such proxy.
SCP_TRUST_PROXY=false

# Space-separated script/style origins artifacts may load from. Empty = cdnjs, jsdelivr, unpkg,
# tailwind and jquery.
SCP_ARTIFACT_CDNS=
